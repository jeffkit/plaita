# Plaita console 环境变量样例（B58-11）
#
# 用法（compose 在 plaita-console/docker/ 下）：
#   cp .env.example plaita-console/docker/.env
#   # 编辑 plaita-console/docker/.env，至少填写下面“必填”三项
#   cd plaita-console/docker && docker compose up -d
#
# 也可以显式指定：
#   docker compose --env-file .env -f plaita-console/docker/docker-compose.yml up -d
#
# 注意：docker compose 的 ${VAR:-change-me-*} 只在变量“未设置或为空”时回退到
# 公开模板值；本文件把敏感项留空并要求填写，未填写时仍然会使用 change-me-*。
# 生产/共享环境必须填写；本地一次性演示可以保持空值。
#
# 本样例覆盖 compose 的必填项与常用 console/worker 变量；不在 compose
# `environment:` 列表里的项用于裸机运行或自行扩展 compose。
#
# 变量完整语义（默认值/读取时机/0 与非法值）见
# docs-site/docs/distributed/ops-runbook.md「环境变量参考」。

# --- 必填：管理面与契约鉴权 ---
# compose 在变量未设置/为空时回退到公开的 change-me-*（B58-01），不会 fail-closed；
# 因此这三项必须填写。裸机启动留空时管理 API / 契约接口才会 503。
# 管理面 API Key（X-Admin-API-Key / Bearer）。生成：openssl rand -hex 32
PLAITA_CONSOLE_ADMIN_API_KEY=
# 对外契约 HMAC 密钥对。ID 可用任意不可猜标识；KEY 生成：openssl rand -hex 32
PLAITA_CONSOLE_SECRET_ID=
PLAITA_CONSOLE_SECRET_KEY=

# --- 常用：console 连接与监听 ---
# Docker compose 内固定使用 redis://redis:6379/0；裸机按实际地址填写
PLAITA_CONSOLE_REDIS_URL=redis://localhost:6379/0
# 仅对非容器启动（run_server）生效；官方 Dockerfile.backend 的 CMD 固定
# --host 0.0.0.0，此变量不改变容器监听地址（A58-01）
PLAITA_CONSOLE_HOST=127.0.0.1
PLAITA_CONSOLE_PORT=8080
PLAITA_CONSOLE_DB_URL=sqlite:///./plaita_console.db
PLAITA_CONSOLE_ENV=dev

# --- 可选：本地开发免密（生产保持 false 或删除）---
PLAITA_CONSOLE_ALLOW_INSECURE_ADMIN=false

# --- 可选：首次启动自动创建 admin（users 表为空时）；不设则走前端创建向导 ---
PLAITA_CONSOLE_ADMIN_PASSWORD=

# --- 可选：需要把流程/执行历史留在宿主机时挂卷并指向该路径 ---
# PLAITA_CONSOLE_DB_URL=sqlite:////app/data/plaita_console.db

# --- 可选：worker / console 生产侧队列（两者改名时必须一起改）---
PLAITA_REDIS_URL=redis://localhost:6379/0
PLAITA_QUEUE_NAME=plaita:flow:queue
PLAITA_CONSOLE_TASK_QUEUE=plaita:flow:queue
PLAITA_CONSUMER_GROUP=plaita-workers
