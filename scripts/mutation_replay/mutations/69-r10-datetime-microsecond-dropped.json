{
  "name": "69-r10-datetime-microsecond-dropped",
  "concern": "#69 r10 字段丢失类：datetime 拷贝必须逐字段保真（不许悄悄清零某个分量）",
  "file": "plaita/core/expression_parser.py",
  "old": "    return datetime.replace(built, fold=datetime.fold.__get__(value))\n",
