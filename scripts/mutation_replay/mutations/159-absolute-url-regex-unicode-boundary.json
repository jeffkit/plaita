{
  "name": "159-absolute-url-regex-unicode-boundary",
  "concern": "#159-r4-P0",
  "issue": "159",
  "file": "plaita/node/http.py",
  "old": "_ABSOLUTE_URL_RE = re.compile(r\"[A-Za-z][A-Za-z0-9+.\\-]{0,31}://[^ \\t\\r\\n\\f\\v]+\")",
  "new": "_ABSOLUTE_URL_RE = re.compile(r\"[A-Za-z][A-Za-z0-9+.\\-]{0,31}://[^\\s]+\")",
  "rationale": "把 token 边界退回 `\\s`（对 str 是 Unicode 感知的）：NBSP / 窄空格 / 表意空格都会「结束」token ⇒ `http://h/x\\u00a0?t=<secret>` 的尾巴原样留下。",
  "expect_fail": [
    "tests/unit/test_issue159_policy_url_exception_sinks.py::TestAsciiOnlyTokenBoundary::test_unicode_spaces_do_not_end_the_token",
    "tests/unit/test_issue159_policy_url_exception_sinks.py::TestAsciiOnlyTokenBoundary::test_boundary_class_is_ascii_only"
  ]
}
