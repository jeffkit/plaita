# 注意: .python-version 不再 ignore —— pyenv 需要它确定项目 Python 版本,
# git clean -fdX 会删它, 删了之后团队/CI 都不知道用哪个解释器。
*.db
*.log
dist
build
# Wheel 构建产物不跟踪（#135）：根目录 11 个 *.whl 已出库，防止仓库膨胀
# 与被 pip 类工具误拾；确需入库的 wheel 用 git add -f 显式添加。
*.whl
*.pyc
.idea
*.egg-info
.pytest_cache
.DS_Store
venv
tmp
.pypirc
.a2a/
.playwright-mcp/
node_modules/
.coverage
.cursor/
.worktrees/
.specify/

# Console test artifacts
*_test_results.json
*_test_screenshots/
console-shots/

# Coverage / mutation testing artifacts
coverage.json
.coverage
.coverage.*
.hang-vout.txt
htmlcov/
mutants/
.mutmut-cache/
mutation-baseline.txt
mutation-recheck.txt
mutation-sweep-results.txt
mutation-unboosted-*.txt
codeflow-*-recheck*.txt
sexpr-recheck.txt
setup.cfg.mutmut_test

.impeccable/

# console 打包时由 build_package.sh 填充的前端产物
plaita-console/backend/webDist/
.build-venv/
plaita-console/docker/docker-compose.override.yml
.argusai/
e2e-artifacts/

# 个人本地用脚本/工具（不入库）
local/
.flowcast/
