# Plaita Console Backend Dockerfile
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends wget curl && rm -rf /var/lib/apt/lists/*

# plaita 核心依赖随最终 pip install . 从 pyproject 解析（仓根 requirements.txt
# 已于 C6 清理删除——列着已裁撤且带 CVCS 公告的 python-jose 等）。cachetools
# 是 console 后端直接 import 的库，不随 plaita base 依赖，显式装。
# 安装 console backend 依赖
COPY plaita-console/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制 plaita 核心包
COPY plaita/ ./plaita/
COPY pyproject.toml .
COPY setup.py .

# plaita 必须真正安装而非仅源码落盘：approval/delay 等扩展节点经
# [project.entry-points."plaita.nodes"] 自动发现，依赖安装元数据——
# setup.py 只是 shim，缺 pyproject.toml 时 pip install . 得到 0.0.0
# 无插件空壳（2026-09 console E2E 实证：保存 approval flow 即 422）
RUN pip install --no-cache-dir setuptools wheel cachetools && \
    pip install --no-cache-dir --no-build-isolation .

# 复制 console backend 运行时（A59-01）：只收窄到入口 *.py + 运行子包。
# 整目录 COPY 会把 tests/、build/lib 旧树、webDist、本地 *.db 与
# __pycache__ 打进镜像；.dockerignore 的递归规则只作纵深防御。
# 新增 backend 顶层运行时目录时需同步这里。
COPY plaita-console/backend/*.py ./backend/
COPY plaita-console/backend/api ./backend/api
COPY plaita-console/backend/migrations ./backend/migrations
COPY plaita-console/backend/models ./backend/models
COPY plaita-console/backend/services ./backend/services

# 复制集群配置文件
COPY plaita-console/cluster_config.yaml ./plaita-console/cluster_config.yaml

EXPOSE 8080

ENV PLAITA_CONSOLE_PORT=8080

CMD uvicorn backend.main:app --host 0.0.0.0 --port ${PLAITA_CONSOLE_PORT}

