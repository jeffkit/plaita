# Flow Worker Dockerfile
FROM python:3.10-slim

WORKDIR /app

# plaita 核心依赖随最终 pip install . 从 pyproject 解析（仓根 requirements.txt
# 已于 C6 清理删除）。cachetools 是 flow_worker 直接 import 的库（plaita server
# extra），显式安装。

# 复制代码
COPY plaita/ ./plaita/
COPY pyproject.toml .
COPY setup.py .

# plaita 必须真正安装而非仅源码落盘：approval/delay 等扩展节点经
# [project.entry-points."plaita.nodes"] 自动发现，依赖安装元数据——
# 不装则 worker 运行含 approval/delay 节点的 flow 即 unRecognized node type
# [server] extra：redis/sqlalchemy/cachetools——flow_worker 与 event_filter
# 模块级 import，缺则容器启动即 ModuleNotFoundError（不消费队列=空列表惨案）
RUN pip install --no-cache-dir setuptools wheel && \
    pip install --no-cache-dir --no-build-isolation '.[server]'

# 默认命令
CMD ["python", "-m", "plaita.server.flow_worker"]

